{
  "openapi": "3.0.0",
  "info": {
    "title": "Nexo - API de Propiedades",
    "version": "1.0.0",
    "description": "Microservicio encargado de gestionar el catálogo de propiedades inmobiliarias del sistema Nexo."
  },
  "servers": [
    { "url": "https://nexo-propiedades.vercel.app", "description": "Producción (Vercel)" },
    { "url": "http://localhost:3006", "description": "Local" }
  ],
  "tags": [
    { "name": "Propiedades", "description": "Gestión de propiedades inmobiliarias" }
  ],
  "paths": {
    "/api/propiedades": {
      "get": {
        "tags": ["Propiedades"],
        "summary": "Obtener todas las propiedades",
        "description": "Retorna todas las propiedades ordenadas por fecha de creación descendente.",
        "responses": {
          "200": {
            "description": "Lista de propiedades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Propiedad" }
                }
              }
            }
          },
          "500": { "description": "Error interno del servidor" }
        }
      },
      "post": {
        "tags": ["Propiedades"],
        "summary": "Crear una nueva propiedad",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePropiedadDto" }
            }
          }
        },
        "responses": {
          "201": { "description": "Propiedad creada exitosamente" },
          "400": { "description": "Datos inválidos" },
          "500": { "description": "Error interno del servidor" }
        }
      }
    },
    "/api/propiedades/{id}": {
      "get": {
        "tags": ["Propiedades"],
        "summary": "Obtener propiedad por ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Propiedad encontrada" },
          "404": { "description": "Propiedad no encontrada" },
          "500": { "description": "Error interno del servidor" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Propiedad": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "codigo": { "type": "string", "example": "TORRE-A-501" },
          "tipo": { "type": "string", "example": "Departamento" },
          "direccion": { "type": "string", "example": "Av. Providencia 1234" },
          "sector": { "type": "string", "example": "Providencia, Santiago" },
          "piso": { "type": "integer", "example": 5 },
          "unidad": { "type": "string", "example": "501" },
          "torre": { "type": "string", "example": "Torre A" },
          "m2": { "type": "integer", "example": 65 },
          "garantia": { "type": "string", "example": "Activa" },
          "creado_en": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePropiedadDto": {
        "type": "object",
        "required": ["codigo", "tipo", "direccion", "sector", "piso", "unidad", "torre", "m2", "garantia"],
        "properties": {
          "codigo": { "type": "string", "example": "TORRE-A-501" },
          "tipo": { "type": "string", "example": "Departamento" },
          "direccion": { "type": "string", "example": "Av. Providencia 1234" },
          "sector": { "type": "string", "example": "Providencia, Santiago" },
          "piso": { "type": "integer", "example": 5 },
          "unidad": { "type": "string", "example": "501" },
          "torre": { "type": "string", "example": "Torre A" },
          "m2": { "type": "integer", "example": 65 },
          "garantia": { "type": "string", "example": "Activa" }
        }
      }
    }
  }
}