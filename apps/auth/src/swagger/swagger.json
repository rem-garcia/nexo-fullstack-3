{
  "openapi": "3.0.0",
  "info": {
    "title": "Nexo - API de Autenticación",
    "version": "1.0.0",
    "description": "Microservicio de autenticación y usuarios. El frontend nunca accede a Supabase directamente: todas las operaciones pasan por esta API REST."
  },
  "servers": [
    { "url": "http://localhost:3003", "description": "Local" }
  ],
  "tags": [
    { "name": "Auth", "description": "Autenticación y gestión de sesión" },
    { "name": "Users", "description": "Gestión de usuarios (solo administradores)" }
  ],
  "paths": {
    "/api/auth": {
      "get": {
        "tags": ["Auth"],
        "summary": "Obtener perfil actual (me)",
        "description": "Valida el JWT del header Authorization y devuelve el perfil del usuario.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Perfil del usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "user": { "$ref": "#/components/schemas/Profile" } }
                }
              }
            }
          },
          "401": { "description": "No autorizado (token ausente o inválido)" }
        }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "Acciones de autenticación",
        "description": "Endpoint multiacción. El campo 'action' define la operación: login, register, reset-request, reset-confirm o logout.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/LoginRequest" },
                  { "$ref": "#/components/schemas/RegisterRequest" },
                  { "$ref": "#/components/schemas/ResetRequest" },
                  { "$ref": "#/components/schemas/ResetConfirm" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Operación exitosa (login devuelve tokens; reset/logout devuelven mensaje)" },
          "201": { "description": "Usuario registrado (action=register)" },
          "400": { "description": "Datos inválidos o acción no válida" },
          "401": { "description": "Credenciales inválidas (action=login)" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Listar usuarios",
        "description": "Devuelve todos los usuarios. Requiere rol admin o super_admin.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": { "type": "array", "items": { "$ref": "#/components/schemas/Profile" } }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado (no es admin o token inválido)" },
          "500": { "description": "Error al obtener usuarios" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Crear usuario",
        "description": "Crea un nuevo usuario. Requiere rol admin o super_admin.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario creado" },
          "400": { "description": "Datos inválidos" },
          "401": { "description": "No autorizado" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "full_name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["super_admin", "admin", "coordinador", "tecnico", "cliente"] },
          "is_active": { "type": "boolean" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["action", "email", "password"],
        "properties": {
          "action": { "type": "string", "example": "login" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["action", "full_name", "email", "password", "role"],
        "properties": {
          "action": { "type": "string", "example": "register" },
          "full_name": { "type": "string", "minLength": 3 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "role": { "type": "string", "enum": ["super_admin", "admin", "coordinador", "tecnico", "cliente"] }
        }
      },
      "ResetRequest": {
        "type": "object",
        "required": ["action", "email"],
        "properties": {
          "action": { "type": "string", "example": "reset-request" },
          "email": { "type": "string", "format": "email" },
          "redirectTo": { "type": "string", "format": "uri" }
        }
      },
      "ResetConfirm": {
        "type": "object",
        "required": ["action", "access_token", "password"],
        "properties": {
          "action": { "type": "string", "example": "reset-confirm" },
          "access_token": { "type": "string" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["full_name", "email", "password", "role"],
        "properties": {
          "full_name": { "type": "string", "minLength": 3 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "role": { "type": "string", "enum": ["super_admin", "admin", "coordinador", "tecnico", "cliente"] },
          "phone": { "type": "string", "nullable": true }
        }
      }
    }
  }
}