# Frontend (Proyecto 1 en Vercel). NO debe tener claves de Supabase:
# el dashboard solo hace fetch a los backends (API REST).

# Backend de auth (apps/auth) → login, "me", logout, recuperación de clave
NEXT_PUBLIC_AUTH_API_URL=https://nexo-auth.vercel.app/api/auth

# Backend de auth → gestión de usuarios
NEXT_PUBLIC_USERS_API_URL=https://nexo-auth.vercel.app/api/users

# Backend de tickets (apps/tickets)
NEXT_PUBLIC_TICKETS_API_URL=https://nexo-fullstack-3.vercel.app/api/tickets

# URLs públicas (para redirecciones y logout)
NEXT_PUBLIC_DASHBOARD_URL=https://nexo-dashboard-six.vercel.app
NEXT_PUBLIC_LANDING_URL=https://nexo-landing-xi.vercel.app
